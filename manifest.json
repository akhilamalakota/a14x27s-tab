{
  "manifest_version": 3,
  "name": "a14x27s-tab",
  "version": "1.0.0",
  "description": "Hide, lock and disguise tabs. Your browser, invisible to everyone but you.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "a14x27s-tab",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "omnibox": { "keyword": "a14" },
  "commands": {
    "panic": { "suggested_key": { "default": "Alt+Shift+X" }, "description": "Panic: lock the whole browser" },
    "lock-tab": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Lock the current tab" },
    "hide-tab": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Hide (disguise) the current tab" },
    "open-panel": { "suggested_key": { "default": "Alt+Shift+O" }, "description": "Open the control panel (works in ghost mode)" }
  },
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage", "idle", "alarms", "offscreen", "browsingData"],
  "host_permissions": ["<all_urls>"]
}
